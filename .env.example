# Copy to .env for `netlify dev`, and set the same names in Netlify > Site settings > Environment variables.
# Never commit real keys.

# Plaid (https://dashboard.plaid.com) - sandbox keys are free
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Alpaca (https://app.alpaca.markets) - paper trading keys are free
ALPACA_KEY_ID=
ALPACA_SECRET=
ALPACA_ENV=paper

# Clerk (https://dashboard.clerk.com) - sign-in. Both are needed: the page key shows the sign-in screen,
# the secret lets the server functions verify each request. Set both in Netlify too.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Safety switches (leave unset). A hosted server refuses calls when sign-in is not configured, and refuses real
# bank or live brokerage accounts because the connection is shared by every user.
# ALLOW_UNAUTHENTICATED=true     - only for a private deployment that should be open
# ALLOW_SHARED_ACCOUNTS=true     - only for a private deployment meant to show one real account
# VITE_ALLOW_NO_AUTH=true        - lets a production build open without a sign-in key (local preview only)
